<section class="cb-rules-assistance-config">
  <header class="cb-app-header cb-rules-assistance-header">
    <i class="fa-solid fa-wand-magic-sparkles"></i>
    <div>
      <h1>Configure Assistance Rules</h1>
      <p>Choose which mechanics Character Builder may assist with in this world.</p>
    </div>
  </header>

  {{#unless masterEnabled}}
  <div class="cb-rules-assistance-master-warning">
    <i class="fa-solid fa-circle-pause"></i>
    Rules Automation Assistance is currently disabled. These choices will be used when the master switch is enabled.
  </div>
  {{/unless}}

  <div class="cb-rules-assistance-summary" data-assistance-rule-summary>
    <strong>{{enabledCount}}</strong> of <strong>{{totalCount}}</strong> assistance rules enabled.
  </div>

  <div class="cb-rules-assistance-list">
    {{#each rules}}
    <article class="cb-rules-assistance-row" data-rule-key="{{key}}">
      <label class="cb-rules-assistance-toggle">
        <input type="checkbox" {{checked enabled}}>
        <span>
          <strong>{{label}}</strong>
          <small>{{description}}</small>
        </span>
      </label>
      <div class="cb-rules-assistance-row-actions">
        {{#if configureAction}}
        <button type="button" class="cb-rules-assistance-configure" data-action="{{configureAction}}"><i class="fa-solid fa-sliders"></i> {{configureLabel}}</button>
        {{/if}}
        <span class="cb-badge">{{tag}}</span>
      </div>
    </article>
    {{/each}}
  </div>

  <section class="cb-rules-assistance-subsettings">
    <label class="cb-rules-assistance-toggle cb-managed-summons-folder-toggle">
      <input type="checkbox" name="managedSummons.organizeFolders" {{checked organizeManagedSummonFolders}}>
      <span>
        <strong>Managed Summons — Organize Companion Actors in Folders</strong>
        <small>When enabled, managed summons are stored per summoner in an Actor folder named &lt;FirstName&gt; - Companions.</small>
      </span>
    </label>
  </section>

  <div class="cb-rules-assistance-note">
    <i class="fa-solid fa-circle-info"></i>
    <span>Best results with characters created, leveled, and maintained through the Character Builder and Character Keeper.</span>
  </div>

  <footer class="cb-footer cb-rules-assistance-footer">
    <button type="button" data-action="cancel"><i class="fa-solid fa-arrow-left"></i> Back</button>
    <button type="button" class="gold-button" data-action="save" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-floppy-disk"></i> Save Assistance Rules
    </button>
  </footer>
</section>
