<div class="supplier-shell">
  <aside class="supplier-steps" aria-label="{{localize 'DND5E_SUPPLIER.Profiles'}}">
    <div class="supplier-brand"><i class="fa-solid fa-store"></i><span>{{localize "DND5E_SUPPLIER.Profiles"}}</span></div>
    <div class="supplier-step-scroll">
      {{#each profiles}}
        <button type="button" class="supplier-step {{themeClass}} {{#if selected}}active{{/if}}" data-profile-id="{{id}}"><i class="{{icon}}"></i><span>{{name}}</span></button>
      {{/each}}
    </div>
  </aside>

  <main class="supplier-workspace">
    {{#if profile}}
      <header class="supplier-profile-header {{profile.themeClass}}">
        <div class="supplier-profile-title"><i class="{{profile.icon}}"></i><div><h1>{{profile.name}}</h1><p>{{profile.description}}</p></div></div>
      </header>

      <section class="supplier-compact-controls">
        <label><span>{{localize "DND5E_SUPPLIER.PartyLevel"}}</span><input type="number" name="partyLevel" min="1" max="20" value="{{level}}" {{#if busy}}disabled{{/if}}></label>
        <label><span>{{localize "DND5E_SUPPLIER.PartySize"}}</span><input type="number" name="partySize" min="1" max="30" value="{{players}}" {{#if busy}}disabled{{/if}}></label>
        <button type="button" class="supplier-primary" data-action="generate" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-dice"></i>{{#if busy}}{{localize "DND5E_SUPPLIER.Working"}}{{else}}{{localize "DND5E_SUPPLIER.Generate"}}{{/if}}</button>
      </section>

      <section class="supplier-loot-panel">
        <div class="supplier-panel-heading">
          <div><h2>{{localize "DND5E_SUPPLIER.GeneratedStock"}}</h2>{{#if hasPreview}}<small>{{distinctItems}} {{localize "DND5E_SUPPLIER.DistinctItems"}} • {{totalUnits}} {{localize "DND5E_SUPPLIER.TotalUnits"}} • {{localize "DND5E_SUPPLIER.CatalogUnits"}} {{catalogUnits}} • {{localize "DND5E_SUPPLIER.GuaranteedUnits"}} {{guaranteedUnits}} • {{localize "DND5E_SUPPLIER.RandomUnits"}} {{randomUnits}}/{{target}}</small>{{/if}}</div>
          {{#if hasPreview}}<button type="button" class="supplier-icon-button" data-action="clear" title="{{localize 'DND5E_SUPPLIER.Clear'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
        </div>

        {{#if warnings.length}}<div class="supplier-warnings">{{#each warnings}}<p><i class="fa-solid fa-triangle-exclamation"></i>{{this}}</p>{{/each}}</div>{{/if}}

        <div class="supplier-loot-scroll">
          {{#if hasPreview}}
            {{#each preview}}
              <article class="supplier-loot-row">
                <img src="{{img}}" alt="{{name}}">
                <div class="supplier-loot-main">
                  <strong>{{name}}</strong>
                  <span>{{rarityLabel}}{{#if qualityLabel}} • {{qualityLabel}}{{/if}}{{#if spellLevelLabel}} • {{spellLevelLabel}}{{/if}} • {{type}}{{#if subtype}} / {{subtype}}{{/if}}</span>
                  <small>{{packLabel}} • {{unitPrice}} • {{priceOriginLabel}}</small>
                </div>
                <label class="supplier-quantity"><span>×</span><input type="number" min="1" max="999" value="{{quantity}}" data-quantity-index="{{index}}"></label>
                <span class="supplier-line-value">{{linePrice}}</span>
                <button type="button" class="supplier-icon-button danger" data-action="remove-line" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></button>
              </article>
            {{/each}}
          {{else}}
            <div class="supplier-empty-state"><i class="fa-solid fa-box-open"></i><h3>{{localize "DND5E_SUPPLIER.EmptyTitle"}}</h3><p>{{localize "DND5E_SUPPLIER.EmptyHint"}}</p></div>
          {{/if}}
        </div>
      </section>

      <footer class="supplier-footer">
        <div class="supplier-total"><span>{{localize "DND5E_SUPPLIER.EstimatedTotal"}}</span><strong>{{totalValue}}</strong></div>
        <button type="button" class="supplier-confirm" data-action="confirm" {{#unless hasPreview}}disabled{{/unless}} {{#if busy}}disabled{{/if}}><i class="fa-solid fa-folder-plus"></i>{{localize "DND5E_SUPPLIER.ConfirmLoot"}}</button>
      </footer>
    {{/if}}
  </main>
</div>
