<div class="cb-source-full-shell">
  <header class="cb-source-full-header">
    <img src="{{img}}" alt="">
    <div>
      <span class="cb-kicker">Source Full Details</span>
      <h2>{{name}}</h2>
      <p>{{#if pageName}}{{pageName}}{{#if packageId}} · {{packageId}}{{/if}}{{else}}Source document{{/if}}</p>
    </div>
    {{#if fallback}}
    <span class="cb-source-full-fallback"><i class="fa-solid fa-circle-info"></i> Document fallback</span>
    {{/if}}
  </header>

  <main class="cb-source-full-content dnd5e2-journal journal-entry-page class {{#if nativePage}}cb-source-full-native{{else}}cb-source-full-document{{/if}}">
    {{{content}}}
  </main>
</div>
