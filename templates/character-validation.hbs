<div class="cb-validation-shell">
  <aside class="cb-validation-sidebar">
    <header class="cb-validation-actor-card">
      <img src="{{actor.img}}" alt="{{actor.name}}">
      <div>
        <small>REVISED COPY</small>
        <h2>{{actor.name}}</h2>
        <p>Original: {{sourceActor.name}}</p>
      </div>
    </header>

    <ol class="cb-validation-steps">
      <li class="{{#if isOverview}}active{{/if}}"><i class="fa-solid fa-magnifying-glass"></i><span>Scan</span></li>
      <li class="{{#if isIssues}}active{{/if}}"><i class="fa-solid fa-list-check"></i><span>Review Issues</span></li>
      <li class="{{#if isReview}}active{{/if}}"><i class="fa-solid fa-clipboard-check"></i><span>Summary</span></li>
      <li class="{{#if isComplete}}active{{/if}}"><i class="fa-solid fa-circle-check"></i><span>Complete</span></li>
    </ol>

    <div class="cb-validation-safety">
      <i class="fa-solid fa-copy"></i>
      <div><strong>Clone-first safety</strong><br><span>The original Actor is never modified by this tool.</span></div>
    </div>
  </aside>

  <main class="cb-validation-main">
    {{#if isOverview}}
      <section class="cb-section-header">
        <div>
          <h2>Character Validation</h2>
          <p>Audit structural integrity and 2024 progression entitlements on the revised copy.</p>
        </div>
      </section>

      <div class="cb-validation-metrics">
        <article><strong>{{scan.issueCount}}</strong><span>Issues Found</span></article>
        <article><strong>{{scan.safeCount}}</strong><span>Safe Repairs</span></article>
        <article><strong>{{scan.guidedCount}}</strong><span>Guided Repairs</span></article>
        <article><strong>{{scan.warningCount}}</strong><span>Review Warnings</span></article>
      </div>

      <section class="cb-validation-panel">
        <h3><i class="fa-solid fa-shield-halved"></i> Validation coverage</h3>
        <div class="cb-validation-coverage">
          {{#each scan.coverage}}
          <div class="cb-validation-coverage-row {{status}}">
            <span>{{label}}</span>
            {{#if (dnd5eCharacterBuilderEq status "checked")}}<strong><i class="fa-solid fa-circle-check"></i> Checked</strong>{{/if}}
            {{#if (dnd5eCharacterBuilderEq status "audit")}}<strong><i class="fa-solid fa-magnifying-glass"></i> Audit</strong>{{/if}}
            {{#if (dnd5eCharacterBuilderEq status "planned")}}<strong><i class="fa-regular fa-clock"></i> Planned</strong>{{/if}}
          </div>
          {{/each}}
        </div>
        <p class="notes">Equipment, currency, ammunition, spent spell slots, current HP, and currently spent resource amounts are outside validation scope. 2014-content usage is not itself an error. A clean scan means every check listed as Checked passed; planned checks are not claimed as validated yet.</p>
      </section>

      <div class="cb-validation-actions">
        <button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> Close</button>
        <button type="button" data-action="open-source"><i class="fa-solid fa-user"></i> Open Original</button>
        <button type="button" data-action="open-revision"><i class="fa-solid fa-copy"></i> Open Revised Copy</button>
        <button type="button" class="gold-button" data-action="start"><i class="fa-solid fa-arrow-right"></i> Start Review</button>
      </div>
    {{/if}}

    {{#if isIssues}}
      <section class="cb-section-header">
        <div>
          <h2>Issue {{issueNumber}} of {{issueTotal}}</h2>
          <p>Review one finding at a time. Repairs apply only to {{actor.name}}.</p>
        </div>
      </section>

      <article class="cb-validation-issue {{currentIssue.severity}}">
        <header>
          <i class="fa-solid {{#if currentIssue.repairable}}fa-wrench{{else}}fa-triangle-exclamation{{/if}}"></i>
          <div>
            <small>{{currentIssue.kind}}</small>
            <h3>{{currentIssue.title}}</h3>
          </div>
        </header>
        <p class="cb-validation-summary">{{currentIssue.summary}}</p>
        <p>{{currentIssue.details}}</p>
        {{#if currentIssue.repairable}}
          {{#if (dnd5eCharacterBuilderEq currentIssue.repairMode "guided")}}
            <div class="cb-validation-repair-badge"><i class="fa-solid fa-list-check"></i> Guided repair — reconcile a legal existing choice or resolve it through the source/native choice flow</div>
          {{else}}
            <div class="cb-validation-repair-badge"><i class="fa-solid fa-shield-check"></i> Safe automatic repair available</div>
          {{/if}}
        {{else}}
          <div class="cb-validation-review-badge"><i class="fa-solid fa-user-shield"></i> GM review required — no automatic grant or deletion</div>
        {{/if}}
        {{#if currentProcessed}}
          <div class="cb-validation-repair-badge"><i class="fa-solid fa-circle-check"></i> Already {{currentResult.status}} in this review</div>
        {{/if}}
      </article>

      <div class="cb-validation-actions split">
        <div>
          {{#if canGoBack}}<button type="button" data-action="previous"><i class="fa-solid fa-arrow-left"></i> Previous</button>{{/if}}
        </div>
        <div>
          {{#if currentProcessed}}
            <button type="button" class="gold-button" data-action="next" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-arrow-right"></i> Continue</button>
          {{else}}
            <button type="button" data-action="skip" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-forward"></i> Skip</button>
            {{#if currentIssue.repairable}}
              <button type="button" class="gold-button" data-action="repair" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-wrench"></i> {{currentIssue.repairLabel}}</button>
            {{/if}}
          {{/if}}
        </div>
      </div>
    {{/if}}

    {{#if isReview}}
      <section class="cb-section-header">
        <div>
          <h2>Review Validation</h2>
          <p>Nothing has been changed on {{sourceActor.name}}.</p>
        </div>
      </section>

      <div class="cb-validation-review-grid">
        <section>
          <h3><i class="fa-solid fa-wrench"></i> Repaired ({{repaired.length}})</h3>
          {{#if repaired.length}}
            <ul>{{#each repaired}}<li>{{message}}</li>{{/each}}</ul>
          {{else}}<p>No automatic repairs were applied.</p>{{/if}}
        </section>
        <section>
          <h3><i class="fa-solid fa-forward"></i> Skipped ({{skipped.length}})</h3>
          {{#if skipped.length}}
            <ul>{{#each skipped}}<li>{{title}}</li>{{/each}}</ul>
          {{else}}<p>No findings were skipped.</p>{{/if}}
        </section>
        <section>
          <h3><i class="fa-solid fa-triangle-exclamation"></i> Unresolved ({{unresolved.length}})</h3>
          {{#if unresolved.length}}
            <ul>{{#each unresolved}}<li>{{title}}</li>{{/each}}</ul>
          {{else}}<p>No unresolved findings remain.</p>{{/if}}
        </section>
      </div>

      <div class="cb-validation-actions">
        <button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> Close</button>
        <button type="button" data-action="open-revision"><i class="fa-solid fa-copy"></i> Inspect Revised Copy</button>
        <button type="button" class="gold-button" data-action="finish" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-check"></i> Finish Validation</button>
      </div>
    {{/if}}

    {{#if isComplete}}
      <section class="cb-validation-complete">
        <i class="fa-solid fa-circle-check"></i>
        <h2>Validation Complete</h2>
        <p><strong>{{actor.name}}</strong> remains in the Actors directory beside the untouched original.</p>
        <p>A chat summary was created with the repairs applied during this review.</p>
        <div class="cb-validation-actions">
          <button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> Close</button>
          <button type="button" class="gold-button" data-action="open-revision"><i class="fa-solid fa-user-pen"></i> Open Revised Character</button>
        </div>
      </section>
    {{/if}}
  </main>
</div>
