<form class="supplier-config-form" autocomplete="off">
  <div class="supplier-config-shell">
    <aside class="supplier-config-nav">
      <div class="supplier-brand"><i class="fa-solid fa-gears"></i><span>{{localize "DND5E_SUPPLIER.Config.Configuration"}}</span></div>
      <button type="button" class="supplier-config-tab {{#if isSources}}active{{/if}}" data-section="sources"><i class="fa-solid fa-books"></i><span>{{localize "DND5E_SUPPLIER.Config.Sources"}}</span></button>
      <button type="button" class="supplier-config-tab {{#if isProfiles}}active{{/if}}" data-section="profiles"><i class="fa-solid fa-store"></i><span>{{localize "DND5E_SUPPLIER.Config.Profiles"}}</span></button>
      <button type="button" class="supplier-config-tab {{#if isProgression}}active{{/if}}" data-section="progression"><i class="fa-solid fa-chart-line"></i><span>{{localize "DND5E_SUPPLIER.Config.Progression"}}</span></button>
      <button type="button" class="supplier-config-tab {{#if isOutput}}active{{/if}}" data-section="output"><i class="fa-solid fa-folder-tree"></i><span>{{localize "DND5E_SUPPLIER.Config.Output"}}</span></button>
    </aside>

    <main class="supplier-config-content" data-scroll-key="config-content">
      {{#if isSources}}
        <header class="supplier-section-header"><h1>{{localize "DND5E_SUPPLIER.Config.Sources"}}</h1><p>{{localize "DND5E_SUPPLIER.Config.SourcesHint"}}</p></header>
        <section class="supplier-card supplier-source-card">
          <div class="supplier-source-list">
            {{#each sources}}
              <div class="supplier-source-row">
                <label class="supplier-switch-row">
                  <input type="checkbox" data-path="sources.{{index}}.enabled" data-source-toggle="{{index}}" {{#if enabled}}checked{{/if}}>
                  <span class="supplier-switch" aria-hidden="true"></span>
                  <span><strong title="{{id}}">{{displayLabel}}</strong></span>
                </label>
                <div class="supplier-source-actions">
                  <button type="button" class="supplier-icon-button" data-action="move-source" data-index="{{index}}" data-direction="-1" {{#unless canMoveUp}}disabled{{/unless}}><i class="fa-solid fa-chevron-up"></i></button>
                  <button type="button" class="supplier-icon-button" data-action="move-source" data-index="{{index}}" data-direction="1" {{#unless canMoveDown}}disabled{{/unless}}><i class="fa-solid fa-chevron-down"></i></button>
                </div>
              </div>
            {{/each}}
          </div>
        </section>
      {{/if}}

      {{#if isProfiles}}
        <div class="supplier-profile-config-layout">
          <aside class="supplier-profile-list">
            <div class="supplier-card-title-row"><h2>{{localize "DND5E_SUPPLIER.Config.Profiles"}}</h2><button type="button" class="supplier-icon-button" data-action="add-profile" title="{{localize 'DND5E_SUPPLIER.Config.AddProfile'}}"><i class="fa-solid fa-plus"></i></button></div>
            <div class="supplier-profile-scroll" data-scroll-key="profile-list">
              {{#each profiles}}
                <button type="button" class="supplier-profile-choice {{themeClass}} {{#if selected}}active{{/if}}" data-profile-id="{{id}}"><i class="{{icon}}"></i><span>{{name}}</span></button>
              {{/each}}

            </div>
          </aside>

          {{#if selectedProfile}}
            <div class="supplier-profile-editor">
              <header class="supplier-section-header profile-editor-header">
                <div><h1>{{selectedProfile.name}}</h1><p>{{localize "DND5E_SUPPLIER.Config.ProfileHumanHint"}}</p></div>
                <button type="button" class="supplier-secondary danger" data-action="delete-profile"><i class="fa-solid fa-trash"></i>{{localize "DND5E_SUPPLIER.Config.DeleteProfile"}}</button>
              </header>

              <nav class="supplier-profile-subnav" aria-label="{{localize 'DND5E_SUPPLIER.Config.ProfileSections'}}">
                <button type="button" class="{{#if profileStockTab}}active{{/if}}" data-profile-section="stock"><i class="fa-solid fa-sliders"></i><span>{{localize "DND5E_SUPPLIER.Config.StockConfiguration"}}</span></button>
                <button type="button" class="{{#if profileBannedTab}}active{{/if}}" data-profile-section="banned"><i class="fa-solid fa-ban"></i><span>{{localize "DND5E_SUPPLIER.Config.BannedItems"}}</span><b>{{profileBannedCount}}</b></button>
              </nav>

              {{#if profileStockTab}}
              <section class="supplier-card">
                <div class="supplier-card-title-row"><div><h2>{{localize "DND5E_SUPPLIER.Config.ProfileIdentity"}}</h2><p>{{localize "DND5E_SUPPLIER.Config.ThemeHint"}}</p></div></div>
                <div class="supplier-grid two">
                  <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.ProfileName"}}</span><input type="text" data-path="profiles.{{selectedProfileIndex}}.name" value="{{selectedProfile.name}}"></label>
                  <label class="supplier-field full"><span>{{localize "DND5E_SUPPLIER.Config.Description"}}</span><textarea data-path="profiles.{{selectedProfileIndex}}.description">{{selectedProfile.description}}</textarea></label>
                </div>
                <div class="supplier-theme-grid">
                  {{#each themeOptions}}
                    <button type="button" class="supplier-theme-card {{themeClass}} {{#if selected}}selected{{/if}}" data-theme-id="{{id}}">
                      <span class="supplier-theme-icon"><i class="{{icon}}"></i>{{#if secondaryIcon}}<i class="{{secondaryIcon}} secondary"></i>{{/if}}</span>
                      <strong>{{localized}}</strong>
                    </button>
                  {{/each}}
                </div>
                {{#if selectedProfile.isCustomTheme}}
                  <label class="supplier-field supplier-advanced-icon"><span>{{localize "DND5E_SUPPLIER.Config.CustomIcon"}}</span><input type="text" data-path="profiles.{{selectedProfileIndex}}.customIcon" data-rerender value="{{selectedProfile.customIcon}}"><small>{{localize "DND5E_SUPPLIER.Config.CustomIconHint"}}</small></label>
                {{/if}}
              </section>

              <section class="supplier-card">
                <div class="supplier-card-title-row"><div><h2>{{localize "DND5E_SUPPLIER.Config.ProfileSources"}}</h2><p>{{localize "DND5E_SUPPLIER.Config.ProfileSourcesHint"}}</p></div></div>
                <div class="supplier-checkbox-grid supplier-source-checkboxes">
                  {{#each profileSourceOptions}}
                    <label><input type="checkbox" data-array-path="profiles.{{../selectedProfileIndex}}.sourceIds" value="{{id}}" data-rerender {{#if checked}}checked{{/if}}><span title="{{id}}">{{displayLabel}}</span></label>
                  {{/each}}
                </div>
              </section>

              <section class="supplier-card supplier-target-card">
                <div class="supplier-card-title-row"><div><h2>{{localize "DND5E_SUPPLIER.Config.RandomStockSize"}}</h2><p>{{localize "DND5E_SUPPLIER.Config.RandomStockSizeHint"}}</p></div></div>
                <div class="supplier-grid three">
                  <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.RandomQuantityMode"}}</span>
                    <select data-path="profiles.{{selectedProfileIndex}}.stockTotalMode" data-rerender>
                      <option value="fixed" {{#if stockTotalFixed}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.FixedRandomTotal"}}</option>
                      <option value="perPlayer" {{#if stockTotalPerPlayer}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.RandomPerPlayer"}}</option>
                    </select>
                  </label>
                  <label class="supplier-field"><span>{{#if stockTotalFixed}}{{localize "DND5E_SUPPLIER.Config.RandomItemTotal"}}{{else}}{{localize "DND5E_SUPPLIER.Config.RandomItemsPerPlayer"}}{{/if}}</span><input type="number" min="0" step="0.5" data-path="profiles.{{selectedProfileIndex}}.stockTotal" data-rerender value="{{selectedProfile.stockTotal}}"></label>
                  <label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.PreviewPartySize"}}</span><input type="number" name="validationPlayers" min="1" max="30" value="{{validationPlayers}}" data-rerender></label>
                </div>
                <div class="supplier-target-summary">
                  <i class="fa-solid fa-dice"></i>
                  <div><strong>{{localize "DND5E_SUPPLIER.Config.RandomTargetPreview"}}: {{calculatedRandomTarget}}</strong><span>{{localize "DND5E_SUPPLIER.Config.RandomTargetAdditional"}}</span></div>
                  <div class="supplier-target-counts"><span>{{localize "DND5E_SUPPLIER.Config.CatalogGroups"}}: <b>{{activeCatalogRules}}</b></span><span>{{localize "DND5E_SUPPLIER.Config.GuaranteedRules"}}: <b>{{activeGuaranteedRules}}</b></span><span>{{localize "DND5E_SUPPLIER.Config.RandomPools"}}: <b>{{activeRandomRules}}</b></span></div>
                </div>
              </section>

              {{#each stockSections}}
                <section class="supplier-card supplier-stock-section supplier-stock-{{kind}}">
                  <div class="supplier-card-title-row">
                    <div><h2><i class="{{icon}}"></i>{{title}}</h2><p>{{hint}}</p></div>
                    <button type="button" class="supplier-secondary" data-action="add-rule" data-kind="{{kind}}"><i class="fa-solid fa-plus"></i>{{addLabel}}</button>
                  </div>

                  {{#if rules.length}}
                    <div class="supplier-rule-list human-rules">
                      {{#each rules}}
                        <details class="supplier-rule-card supplier-rule-details {{#unless poolValid}}pool-invalid{{/unless}}" data-rule-id="{{id}}" open>
                          <summary class="supplier-rule-summary">
                            <span class="supplier-rule-summary-main"><i class="fa-solid {{#if enabled}}fa-circle-check{{else}}fa-circle-pause{{/if}}"></i><strong>{{#if name}}{{name}}{{else}}{{categoryLabel}}{{/if}}</strong><small>{{summary}}</small></span>
                            <span class="supplier-rule-pool-badge {{#unless poolValid}}invalid{{/unless}}">{{poolCount}}</span>
                            <i class="fa-solid fa-chevron-down supplier-rule-chevron"></i>
                          </summary>
                          <div class="supplier-rule-body">
                          <div class="supplier-rule-toolbar">
                            <label class="supplier-inline-check rule-enabled"><input type="checkbox" data-path="{{path}}.enabled" data-rerender {{#if enabled}}checked{{/if}}><span>{{localize "DND5E_SUPPLIER.Config.UseRule"}}</span></label>
                            <input class="supplier-rule-name" type="text" data-path="{{path}}.name" value="{{name}}" placeholder="{{categoryLabel}}">
                            <button type="button" class="supplier-icon-button danger" data-action="remove-rule" data-kind="{{kind}}" data-index="{{index}}"><i class="fa-solid fa-trash"></i></button>
                          </div>

                          <div class="supplier-rule-primary-row {{#if isRandom}}random-row{{/if}}">
                            <label class="supplier-field category-field"><span>{{localize "DND5E_SUPPLIER.Config.ItemType"}}</span>
                              <select data-path="{{path}}.category" data-rerender>
                                <option value="">— {{localize "DND5E_SUPPLIER.Config.ChooseCategory"}} —</option>
                                {{#each categoryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localized}}</option>{{/each}}
                              </select>
                            </label>

                            {{#if hasCategory}}
                              {{#if showQuantity}}
                                <label class="supplier-field quantity-mode-field"><span>{{#if isCatalog}}{{localize "DND5E_SUPPLIER.Config.QuantityPerItem"}}{{else}}{{localize "DND5E_SUPPLIER.Config.GuaranteedQuantityMode"}}{{/if}}</span>
                                  <select data-path="{{path}}.quantityMode" data-rerender>
                                    <option value="fixed" {{#if quantityFixed}}selected{{/if}}>{{#if isCatalog}}{{localize "DND5E_SUPPLIER.Config.ScarceOneEach"}}{{else}}{{localize "DND5E_SUPPLIER.Config.Fixed"}}{{/if}}</option>
                                    <option value="players" {{#if quantityPlayers}}selected{{/if}}>{{#if isCatalog}}{{localize "DND5E_SUPPLIER.Config.AbundantPerPlayer"}}{{else}}{{localize "DND5E_SUPPLIER.Config.PerPlayer"}}{{/if}}</option>
                                    <option value="halfDown" {{#if quantityHalfDown}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.ModerateHalfDown"}}</option>
                                    <option value="halfUp" {{#if quantityHalfUp}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.ModerateHalfUp"}}</option>
                                    {{#unless isCatalog}}<option value="range" {{#if quantityRange}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.Range"}}</option>{{/unless}}
                                  </select>
                                </label>
                                {{#if quantityRange}}
                                  <label class="supplier-field mini-field"><span>{{localize "DND5E_SUPPLIER.Config.Minimum"}}</span><input type="number" min="0" data-path="{{path}}.quantityMin" value="{{quantityMin}}"></label>
                                  <label class="supplier-field mini-field"><span>{{localize "DND5E_SUPPLIER.Config.Maximum"}}</span><input type="number" min="0" data-path="{{path}}.quantityMax" value="{{quantityMax}}"></label>
                                {{else}}
                                  <label class="supplier-field mini-field"><span>{{#if isCatalog}}{{localize "DND5E_SUPPLIER.Config.QuantityEach"}}{{else}}{{localize "DND5E_SUPPLIER.Config.Slots"}}{{/if}}</span><input type="number" min="0" step="1" data-path="{{path}}.quantity" value="{{quantity}}"></label>
                                {{/if}}
                              {{/if}}
                              {{#if showRandomWeight}}
                                <label class="supplier-field random-weight-field"><span>{{localize "DND5E_SUPPLIER.Config.RandomPoolWeight"}}</span><input type="number" min="0.1" step="0.1" data-path="{{path}}.randomWeight" value="{{randomWeight}}"><small>{{localize "DND5E_SUPPLIER.Config.RandomPoolWeightHint"}}</small></label>
                              {{/if}}
                            {{/if}}
                          </div>

                          {{#if hasCategory}}
                            {{#if isExact}}
                              <div class="supplier-exact-picker"><div><span>{{localize "DND5E_SUPPLIER.Config.SelectedItem"}}</span><strong>{{itemLabel}}</strong></div><button type="button" class="supplier-secondary" data-action="pick-exact" data-kind="{{kind}}" data-index="{{index}}"><i class="fa-solid fa-magnifying-glass"></i>{{localize "DND5E_SUPPLIER.Config.Browse"}}</button></div>
                            {{/if}}

                            {{#if isHealingPotions}}
                              <div class="supplier-family-note"><i class="fa-solid fa-flask"></i><div><strong>{{localize "DND5E_SUPPLIER.Config.HealingFamilyTitle"}}</strong><span>{{localize "DND5E_SUPPLIER.Config.HealingFamilyHint"}}</span></div></div>
                            {{/if}}

                            {{#if showSubtypeFilters}}
                              <div class="supplier-dependent-block supplier-native-subtypes">
                                <h3>{{localize "DND5E_SUPPLIER.Config.NativeSubtypes"}}</h3>
                                <p>{{localize "DND5E_SUPPLIER.Config.NativeSubtypesHint"}}</p>
                                <div class="supplier-checkbox-grid compact">{{#each subtypeOptions}}<label><input type="checkbox" data-array-path="{{../path}}.subtypes" value="{{value}}" data-rerender {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div>
                                {{#unless isCatalog}}{{#if hasMultipleBuckets}}<div class="supplier-two-stage-note"><i class="fa-solid fa-folder-tree"></i><span>{{localize "DND5E_SUPPLIER.Config.TwoStageRollHint"}}</span></div>{{/if}}{{/unless}}
                              </div>
                            {{/if}}

                            {{#if isSpellScroll}}
                              <div class="supplier-dependent-block"><div class="supplier-grid two"><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.SpellLevelMode"}}</span><select data-path="{{path}}.spellLevelMode" data-rerender><option value="level" {{#if spellLevelByParty}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.ByPartyLevel"}}</option><option value="fixed" {{#if spellLevelFixed}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.FixedList"}}</option></select></label></div>{{#if spellLevelFixed}}<div class="supplier-checkbox-grid compact">{{#each spellLevelOptions}}<label><input type="checkbox" data-array-path="{{../path}}.spellLevels" value="{{level}}" data-rerender {{#if checked}}checked{{/if}}><span>{{level}}</span></label>{{/each}}</div>{{/if}}</div>
                            {{/if}}

                            {{#if showCoverage}}
                              <div class="supplier-dependent-block supplier-coverage-block"><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.HowToUseQuantity"}}</span><select data-path="{{path}}.coverageMode" data-rerender><option value="slots" {{#if coverageSlots}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.IndependentSlots"}}</option><option value="oneEach" {{#if coverageOneEach}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.OneEachSelectedSubtype"}}</option></select></label></div>
                            {{/if}}

                            {{#if showMagicState}}
                              <div class="supplier-dependent-block"><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.MagicState"}}</span><select data-path="{{path}}.magicalState" data-rerender><option value="any" {{#if magicalAny}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.Any"}}</option><option value="mundane" {{#if magicalMundane}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.Mundane"}}</option><option value="magical" {{#if magicalMagical}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.Magical"}}</option></select></label></div>
                            {{/if}}

                            {{#if showRarity}}
                              <div class="supplier-dependent-block"><div class="supplier-grid two"><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.RarityMode"}}</span><select data-path="{{path}}.rarityMode" data-rerender><option value="level" {{#if rarityLevel}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.ByPartyLevel"}}</option><option value="fixed" {{#if rarityFixed}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.FixedList"}}</option></select></label></div>{{#if rarityFixed}}<div class="supplier-checkbox-grid compact">{{#each rarityOptions}}<label><input type="checkbox" data-array-path="{{../path}}.rarities" value="{{value}}" data-rerender {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div>{{/if}}</div>
                            {{/if}}

                            {{#if showQuality}}
                              <div class="supplier-dependent-block supplier-quality-block"><h3>{{localize "DND5E_SUPPLIER.Config.Quality"}}</h3><div class="supplier-grid three"><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.QualityMode"}}</span><select data-path="{{path}}.qualityMode" data-rerender><option value="source" {{#if qualitySource}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.KeepSourceQuality"}}</option><option value="party" {{#if qualityParty}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.RollPartyQuality"}}</option><option value="mundane" {{#if qualityMundane}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.ForceMundane"}}</option><option value="fixed" {{#if qualityFixed}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.FixedBonus"}}</option></select></label>{{#if qualityFixed}}<label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.EnchantmentBonus"}}</span><select data-path="{{path}}.fixedBonus"><option value="1" {{#if fixedBonus1}}selected{{/if}}>+1</option><option value="2" {{#if fixedBonus2}}selected{{/if}}>+2</option><option value="3" {{#if fixedBonus3}}selected{{/if}}>+3</option></select></label>{{/if}}<label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.MinimumEnchanted"}}</span><select data-path="{{path}}.enchantedMinimumMode" data-rerender><option value="none" {{#if minimumNone}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.NoneGuaranteed"}}</option><option value="fixed" {{#if minimumFixed}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.Fixed"}}</option><option value="players" {{#if minimumPlayers}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.PerPlayer"}}</option><option value="halfDown" {{#if minimumHalfDown}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.HalfPlayersDown"}}</option><option value="halfUp" {{#if minimumHalfUp}}selected{{/if}}>{{localize "DND5E_SUPPLIER.Config.HalfPlayersUp"}}</option></select></label>{{#unless minimumNone}}<label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.Multiplier"}}</span><input type="number" min="0" data-path="{{path}}.enchantedMinimum" value="{{enchantedMinimum}}"></label>{{/unless}}</div>{{#if qualitySource}}<div class="supplier-quality-note warning"><i class="fa-solid fa-triangle-exclamation"></i><span>{{localize "DND5E_SUPPLIER.Config.SourceQualityWarning"}}</span></div>{{else}}{{#if qualityParty}}<div class="supplier-quality-note"><i class="fa-solid fa-dice"></i><span>{{localize "DND5E_SUPPLIER.Config.PartyQualityExplanation"}}</span></div>{{/if}}{{/if}}</div>
                            {{/if}}

                            <div class="supplier-rule-options-row">
                              {{#unless isCatalog}}<label class="supplier-inline-check"><input type="checkbox" data-path="{{path}}.allowDuplicates" {{#if allowDuplicates}}checked{{/if}}><span>{{localize "DND5E_SUPPLIER.Config.AllowDuplicates"}}</span></label>{{/unless}}
                            </div>

                            <div class="supplier-pool-preview {{#unless poolValid}}invalid{{/unless}}">
                              <i class="fa-solid {{#if poolValid}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i>
                              <div><strong>{{poolSummary}}</strong>{{#if poolBuckets.length}}<small class="supplier-bucket-summary">{{#each poolBuckets}}{{label}}: {{count}}{{#unless @last}} • {{/unless}}{{/each}}</small>{{else}}{{#if poolNames.length}}<small>{{#each poolNames}}{{this}}{{#unless @last}} • {{/unless}}{{/each}}</small>{{/if}}{{/if}}</div>
                            </div>
                          {{/if}}
                          </div>
                        </details>
                      {{/each}}
                    </div>
                  {{else}}
                    <div class="supplier-empty-rules"><i class="{{icon}}"></i><span>{{localize "DND5E_SUPPLIER.Config.NoRulesYet"}}</span></div>
                  {{/if}}
                </section>
              {{/each}}

              <details class="supplier-validation-panel">
                <summary><i class="fa-solid fa-magnifying-glass-chart"></i><span>{{localize "DND5E_SUPPLIER.Config.PoolValidationTitle"}}</span></summary>
                <div class="supplier-validation-strip">
                  <span>{{localize "DND5E_SUPPLIER.Config.PoolValidationLevel"}}</span>
                  <input type="number" name="validationLevel" min="1" max="20" value="{{validationLevel}}" data-rerender>
                  <small>{{localize "DND5E_SUPPLIER.Config.PoolValidationHint"}}</small>
                </div>
              </details>
              {{/if}}

              {{#if profileBannedTab}}
                <section class="supplier-profile-banned-page">
                  <header class="supplier-banned-page-header">
                    <div>
                      <h2><i class="fa-solid fa-ban"></i>{{localize "DND5E_SUPPLIER.Config.ProfileBannedItems"}}</h2>
                      <p>{{localize "DND5E_SUPPLIER.Config.ProfileBannedItemsHint"}}</p>
                    </div>
                    <button type="button" class="supplier-secondary" data-action="add-banned-items"><i class="fa-solid fa-plus"></i>{{localize "DND5E_SUPPLIER.Config.AddBannedItems"}}</button>
                  </header>

                  <div class="supplier-banned-toolbar">
                    <label class="supplier-banned-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-ban-filter="search" placeholder="{{localize 'DND5E_SUPPLIER.Config.SearchBannedItems'}}"></label>
                    <select data-ban-filter="type"><option value="">{{localize "DND5E_SUPPLIER.Picker.AllTypes"}}</option>{{#each bannedTypeOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
                    <select data-ban-filter="source"><option value="">{{localize "DND5E_SUPPLIER.Picker.AllSources"}}</option>{{#each bannedSourceOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select>
                    <select data-ban-filter="scope"><option value="">{{localize "DND5E_SUPPLIER.Config.AllBanScopes"}}</option><option value="source">{{localize "DND5E_SUPPLIER.Config.OnlyThisSource"}}</option><option value="all">{{localize "DND5E_SUPPLIER.Config.AllEquivalentSources"}}</option></select>
                  </div>

                  <div class="supplier-banned-summary">
                    <span><b data-visible-bans>{{profileBannedCount}}</b> {{localize "DND5E_SUPPLIER.Config.VisibleBannedItems"}}</span>
                    <button type="button" class="supplier-secondary danger" data-action="remove-selected-bans"><i class="fa-solid fa-trash"></i>{{localize "DND5E_SUPPLIER.Config.RemoveSelected"}}</button>
                  </div>

                  {{#if profileBannedItems.length}}
                    <div class="supplier-profile-banned-list">
                      {{#each profileBannedItems}}
                        <article class="supplier-profile-banned-row" data-banned-row data-name="{{normalizedName}}" data-type="{{normalizedType}}" data-source="{{normalizedSource}}" data-scope="{{scopeValue}}">
                          <label class="supplier-ban-select"><input type="checkbox" data-ban-select value="{{id}}"><span></span></label>
                          <img src="{{img}}" alt="">
                          <div class="supplier-ban-main"><strong>{{name}}</strong><small>{{type}}{{#if subtype}} / {{subtype}}{{/if}}</small></div>
                          <div class="supplier-ban-source"><strong>{{sourceLabel}}</strong><small>{{scopeLabel}}</small><em>{{equivalentNote}}</em></div>
                          <button type="button" class="supplier-icon-button danger" data-action="remove-banned-item" data-ban-id="{{id}}" title="{{localize 'DND5E_SUPPLIER.Config.RemoveBan'}}"><i class="fa-solid fa-xmark"></i></button>
                        </article>
                      {{/each}}
                    </div>
                  {{else}}
                    <div class="supplier-empty-rules supplier-banned-empty"><i class="fa-solid fa-shield"></i><span>{{localize "DND5E_SUPPLIER.Config.NoProfileBannedItems"}}</span></div>
                  {{/if}}
                </section>
              {{/if}}
            </div>
          {{/if}}
        </div>
      {{/if}}

      {{#if isProgression}}
        <header class="supplier-section-header"><h1>{{localize "DND5E_SUPPLIER.Config.Progression"}}</h1><p>{{localize "DND5E_SUPPLIER.Config.ProgressionHint"}}</p></header>
        <section class="supplier-card">
          <div class="supplier-card-title-row"><div><h2>{{localize "DND5E_SUPPLIER.Config.LevelBands"}}</h2><p>{{localize "DND5E_SUPPLIER.Config.LevelBandsHint"}}</p></div><button type="button" class="supplier-secondary" data-action="add-band"><i class="fa-solid fa-plus"></i>{{localize "DND5E_SUPPLIER.Config.AddBand"}}</button></div>
          <div class="supplier-band-list">{{#each levelBands}}<article class="supplier-rule-card"><div class="supplier-rule-toolbar"><strong>{{localize "DND5E_SUPPLIER.Config.LevelBand"}}</strong><button type="button" class="supplier-icon-button danger" data-action="remove-band" data-index="{{index}}"><i class="fa-solid fa-trash"></i></button></div><div class="supplier-grid three"><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.MinLevel"}}</span><input type="number" min="1" max="20" data-path="levelBands.{{index}}.min" value="{{min}}"></label><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.MaxLevel"}}</span><input type="number" min="1" max="20" data-path="levelBands.{{index}}.max" value="{{max}}"></label><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.MaxSpellLevel"}}</span><input type="number" min="0" max="9" data-path="levelBands.{{index}}.maxSpellLevel" value="{{maxSpellLevel}}"></label></div><div class="supplier-checkbox-grid compact-top">{{#each rarityOptions}}<label><input type="checkbox" data-array-path="levelBands.{{../index}}.rarities" value="{{value}}" {{#if checked}}checked{{/if}}><span>{{label}}</span></label>{{/each}}</div></article>{{/each}}</div>
        </section>
        <section class="supplier-card">
          <div class="supplier-card-title-row"><div><h2>{{localize "DND5E_SUPPLIER.Config.EnchantmentBands"}}</h2><p>{{localize "DND5E_SUPPLIER.Config.EnchantmentBandsHint"}}</p></div><button type="button" class="supplier-secondary" data-action="add-quality-band"><i class="fa-solid fa-plus"></i>{{localize "DND5E_SUPPLIER.Config.AddBand"}}</button></div>
          <div class="supplier-band-list">{{#each enchantmentBands}}<article class="supplier-rule-card"><div class="supplier-rule-toolbar"><strong>{{localize "DND5E_SUPPLIER.Config.QualityBand"}}</strong><button type="button" class="supplier-icon-button danger" data-action="remove-quality-band" data-index="{{index}}"><i class="fa-solid fa-trash"></i></button></div><div class="supplier-grid three"><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.MinLevel"}}</span><input type="number" min="1" max="20" data-path="enchantmentBands.{{index}}.min" value="{{min}}"></label><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.MaxLevel"}}</span><input type="number" min="1" max="20" data-path="enchantmentBands.{{index}}.max" value="{{max}}"></label></div><div class="supplier-grid four compact-top"><label class="supplier-field"><span>{{localize "DND5E_SUPPLIER.Config.MundaneWeight"}}</span><input type="number" min="0" data-path="enchantmentBands.{{index}}.weights.0" value="{{weight0}}"></label><label class="supplier-field"><span>+1</span><input type="number" min="0" data-path="enchantmentBands.{{index}}.weights.1" value="{{weight1}}"></label><label class="supplier-field"><span>+2</span><input type="number" min="0" data-path="enchantmentBands.{{index}}.weights.2" value="{{weight2}}"></label><label class="supplier-field"><span>+3</span><input type="number" min="0" data-path="enchantmentBands.{{index}}.weights.3" value="{{weight3}}"></label></div></article>{{/each}}</div>
        </section>
        <section class="supplier-card"><div class="supplier-card-title-row"><div><h2>{{localize "DND5E_SUPPLIER.Config.PriceFallbacks"}}</h2><p>{{localize "DND5E_SUPPLIER.Config.PriceFallbacksHint"}}</p></div></div><div class="supplier-grid three">{{#each rarities}}<label class="supplier-field"><span>{{localized}}</span><div class="supplier-money-input"><input type="number" min="1" data-path="priceFallbacks.{{value}}" value="{{price}}"><em>GP</em></div></label>{{/each}}</div></section>
        <section class="supplier-card"><div class="supplier-card-title-row"><div><h2>{{localize "DND5E_SUPPLIER.Config.QualityPriceAdditions"}}</h2><p>{{localize "DND5E_SUPPLIER.Config.QualityPriceAdditionsHint"}}</p></div></div><div class="supplier-grid three">{{#each qualityPrices}}<label class="supplier-field"><span>+{{bonus}}</span><div class="supplier-money-input"><input type="number" min="0" data-path="qualityPriceAdditions.{{bonus}}" value="{{price}}"><em>GP</em></div></label>{{/each}}</div></section>
      {{/if}}

      {{#if isOutput}}
        <header class="supplier-section-header"><h1>{{localize "DND5E_SUPPLIER.Config.Output"}}</h1><p>{{localize "DND5E_SUPPLIER.Config.OutputHint"}}</p></header>
        <section class="supplier-card"><h2>{{localize "DND5E_SUPPLIER.Config.FolderName"}}</h2><label class="supplier-field full"><span>{{localize "DND5E_SUPPLIER.Config.Template"}}</span><input type="text" data-path="folderNameTemplate" value="{{folderNameTemplate}}"><small>{{localize "DND5E_SUPPLIER.Config.TemplateHint"}}</small></label></section>
      {{/if}}
    </main>
  </div>

  <footer class="supplier-config-footer"><span>{{localize "DND5E_SUPPLIER.Config.SaveHint"}}</span><button type="button" class="supplier-primary" data-action="save"><i class="fa-solid fa-floppy-disk"></i>{{localize "DND5E_SUPPLIER.Config.SaveChanges"}}</button></footer>
</form>
